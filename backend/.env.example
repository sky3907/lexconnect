# Environment Variables for Backend Service
# Copy this to .env in the backend directory

# Python Environment
PYTHON_VERSION=3.10

# Service Configuration
PORT=8000
HOST=0.0.0.0

# RAG Service Configuration
RAG_SERVICE_URL=http://localhost:8001
# For production: RAG_SERVICE_URL=https://lexconnect-rag-service.onrender.com

# Database Configuration
# For local development with SQLite:
DATABASE_URL=sqlite:///./lexconnect.db

# For production with PostgreSQL:
# DATABASE_URL=postgresql://username:password@db-host:5432/lexconnect_db

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
# For production: CORS_ORIGINS=https://lexconnect-frontend.onrender.com

# API Configuration
USE_CASE_CONTEXT=true
CASE_CONTEXT_ENABLED=true

# Logging
LOG_LEVEL=INFO

# Optional: Email/Notifications
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
